# Himalayas é uma API pública: não precisa de chave nem cadastro.
# Países ISO alpha-2. BR inclui vagas mundiais e vagas que aceitam candidatos no Brasil.
COUNTRIES=BR,US,GB,CA

# Termos pesquisados separadamente
SEARCH_TERMS=software developer,data analyst,customer support,marketing analyst,python developer

# Máximo de páginas por termo/país (20 vagas por página)
MAX_PAGES_PER_SEARCH=1

# A base da Himalayas é atualizada diariamente; padrão recomendado: 24 horas.
SCHEDULE_HOURS=24

DATABASE_PATH=data/jobs.db

# Telegram Bot API: crie um bot com @BotFather e obtenha seu chat ID.
# Não compartilhe este token e nunca o publique no GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
